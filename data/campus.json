  "pois": [
    {
      "id": "poi_entrada",
      "title": "Portaria Principal e Histórico (1996)",
      "subtitle": "Av. Copacabana, 100 — Primeiro câmpus do IFSul fora de Pelotas",
      "position": [
        -49.5,
        0.0,
        8.2
      ],
      "description": "Inaugurado em 26 de fevereiro de 1996 como Unidade de Ensino Descentralizada (UNED) da Escola Técnica Federal de Pelotas, o Câmpus Sapucaia do Sul foi o primeiro câmpus do IFSul estabelecido fora de Pelotas. Em 1999 integrou o CEFET-RS e, em 2008 (Lei nº 11.892), tornou-se câmpus do Instituto Federal Sul-rio-grandense. O terreno soma mais de 38 mil m² (~16 mil m² construídos) no polo industrial da Região Metropolitana."
    },
    {
      "id": "poi_setor100_auditorio",
      "title": "Setor 100 (Administração/Saúde) e Auditório 504",
      "subtitle": "Direção-Geral, Ensino, Saúde (112), Psicologia (106) e Auditório Pedro Kaizer",
      "position": [
        -32.5,
        0.0,
        -4.5
      ],
      "description": "O Setor 100 reúne a Direção-Geral (115), Departamento de Administração (116), Departamento de Ensino (105), Assistência Estudantil (103), Coordenação Pedagógica (104), Setor de Saúde (112), Psicologia (106) e o corredor de Convivência (119), Impressões (118) e Telefonia (120) ao redor do jardim interno. Logo à frente ergue-se o Auditório 504 — Pedro Kaizer, espaço cultural e acadêmico com 300 lugares."
    },
    {
      "id": "poi_setor200_ensino",
      "title": "Setor 200 — Ensino, CORAC, Miniauditório 201 e Cantina",
      "subtitle": "Salas de aula, Labs 1–6 de Informática, Eventos (231) e Lab de Inovação (234)",
      "position": [
        -16.5,
        0.0,
        3.5
      ],
      "description": "Coração acadêmico do câmpus: pela Recepção acessam-se o Miniauditório (201), o Apoio Acadêmico, a CORAC (Registros Acadêmicos), as salas 205–218, Galeria (216), MEV (217) e os Laboratórios de Informática 1 a 6 (219–228). No Setor 230, contíguo ao Auditório 504, ficam a Cantina, o Lab de Práticas em Eventos (231), a Depep (233) e o Lab de Inovação (234)."
    },
    {
      "id": "poi_setor300_plasticos",
      "title": "Setor 300 — Plásticos, Química (304) e Modular 309",
      "subtitle": "Transformação de polímeros, reciclagem, controle de qualidade e biologia",
      "position": [
        16.5,
        0.0,
        -39.0
      ],
      "description": "Pavilhão industrial dedicado aos cursos de Plásticos e Química, abrigando o Laboratório de Plásticos (extrusão, sopro e injeção), LCQ (303 — Controle de Qualidade), Laboratório de Química (304), Reciclagem (305), Sala de Laboratoristas (306), Lab de Bio (307), Antiga Sala 8 (308) e a sala Novíssima Modular (309)."
    },
    {
      "id": "poi_setor400_mecanica",
      "title": "Setor 400 — Engenharia Mecânica, CNC (401) e DIMP (405)",
      "subtitle": "Usinagem convencional e CNC, desenho técnico, manutenção e infraestrutura",
      "position": [
        32.0,
        0.0,
        53.0
      ],
      "description": "Complexo de Engenharia Mecânica e cursos técnicos em Mecânica no setor sudeste: concentra o grande Laboratório de Mecânica (usinagem, soldagem, metrologia e ensaios), Laboratório CNC (401), Laboratório 7 (402), sala de Desenho Técnico / Antiga 14 (403), DIMP (405) e a oficina de Manutenção."
    },
    {
      "id": "poi_bloco800_horta",
      "title": "Bloco 800 (Salas 801–812, DA/Grêmio 807) e Horta",
      "subtitle": "Prédio em cruz no nordeste com Lab. de Física (804) e convivência estudantil",
      "position": [
        16.5,
        0.0,
        -80.5
      ],
      "description": "Edificação em formato de cruz no quadrante nordeste, junto à Horta experimental do câmpus. Reúne as salas 801 a 812 (antigas P01–P10), o Laboratório de Física (804 / P03), sanitários (803 e 810) e, no miolo central, o Diretório Acadêmico e o Grêmio Estudantil (807 / P10)."
    },
    {
      "id": "poi_biblioteca_sul",
      "title": "Biblioteca do Câmpus e Lago dos Patos",
      "subtitle": "Prédio próprio no setor sul (>580 m²), acervo, leitura e Sede Social",
      "position": [
        -11.0,
        0.0,
        102.0
      ],
      "description": "Localizada no setor sul do câmpus, após o Lago dos Patos e acessada pela alameda em Y que também conduz à Sede Social, a Biblioteca dispõe de mais de 580 m² em planta em cruz com balcão central, salão de leitura, cabines de estudo e amplo acervo técnico, científico e literário aberto à comunidade."
    },
    {
      "id": "poi_esportes",
      "title": "Complexo Esportivo e Educação Física",
      "subtitle": "Quadra poliesportiva coberta, quadra externa, vôlei de areia e Educação Física",
      "position": [
        -40.5,
        0.0,
        -88.0
      ],
      "description": "Setor noroeste dedicado ao esporte e à qualidade de vida, reunindo o bloco de Educação Física (academia e vestiários), a Quadra Poliesportiva Coberta em estrutura metálica azul, a Quadra de Vôlei de areia e a quadra poliesportiva descoberta situada entre o ginásio e o Setor 100."
    }
  ]
}
