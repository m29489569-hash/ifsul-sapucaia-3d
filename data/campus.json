  "pois": [
    {
      "id": "poi_entrada",
      "title": "Portaria Principal e Histórico (1996)",
      "subtitle": "Av. Copacabana, 100 — Primeiro câmpus do IFSul fora de Pelotas",
      "position": [-51.0, 0.0, 5.5],
      "description": "Inaugurado em 26 de fevereiro de 1996 como Unidade de Ensino Descentralizada (UNED) da Escola Técnica Federal de Pelotas, o Câmpus Sapucaia do Sul foi o primeiro câmpus do IFSul estabelecido fora de Pelotas. Em 1999 integrou o CEFET-RS e, em 2008 (Lei nº 11.892), tornou-se câmpus do Instituto Federal Sul-rio-grandense. O terreno soma mais de 38 mil m² (cerca de 16 mil m² construídos) no polo industrial da Região Metropolitana."
    },
    {
      "id": "poi_administrativo",
      "title": "Bloco Administrativo e Auditório Pedro Kaizer",
      "subtitle": "Gestão acadêmica, direção e espaço cultural para 300 lugares",
      "position": [-39.0, 0.0, -10.5],
      "description": "Reúne a Direção-Geral, Diretorias de Ensino, Pesquisa e Extensão, Registros Acadêmicos e a recepção institucional. Anexo ao eixo central encontra-se o Auditório Pedro Kaizer, com capacidade para 300 poltronas e acessibilidade, além de um miniauditório para 50 pessoas que sediam palestras, formaturas, mostras científicas e eventos culturais."
    },
    {
      "id": "poi_cursos",
      "title": "Ensino, Salas de Aula e Cursos Ofertados",
      "subtitle": "Ensino gratuito técnico, superior e pós-graduação",
      "position": [-12.0, 0.0, -3.5],
      "description": "O câmpus conta com 18 salas de aula climatizadas, laboratórios de informática e salas de estudo. Oferta cursos Técnicos Integrados e EJA (Mecânica, Plásticos, Desenvolvimento de Sistemas, Informática, Eventos e Administração), Graduações (Engenharia Mecânica, Análise e Desenvolvimento de Sistemas, Licenciatura em Matemática e EAD) e Pós-Graduações em Educação e Manufatura Avançada."
    },
    {
      "id": "poi_laboratorios",
      "title": "Complexo de Laboratórios Industriais",
      "subtitle": "Mecânica, Plásticos, Química e Inovação Tecnológica",
      "position": [16.5, 0.0, -39.0],
      "description": "Pavilhões equipados para prática industrial de ponta: usinagem convencional e CNC, soldagem, metrologia, hidráulica, pneumática, metalografia e microscopia na área de Mecânica; extrusão, sopro, injeção, reciclagem, química e controle de qualidade em Plásticos; além do Laboratório de Inovação STEAM premiado em projetos tecnológicos."
    },
    {
      "id": "poi_biblioteca",
      "title": "Biblioteca do Câmpus",
      "subtitle": "Prédio próprio inaugurado em 2014 com mais de 580 m²",
      "position": [16.5, 0.0, -80.5],
      "description": "Inaugurada em 2014 em edificação exclusiva ao norte do complexo acadêmico, a Biblioteca dispõe de salão de leitura, cabines de estudo individual e em grupo, guarda-volumes, espaço infanteca e acervo com milhares de obras técnicas, científicas e literárias disponíveis à comunidade interna e externa."
    },
    {
      "id": "poi_esportes",
      "title": "Complexo Esportivo e Convivência",
      "subtitle": "Quadras poliesportivas, academia, saúde e áreas estudantis",
